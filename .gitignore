# ====================================================================
# Digital Image Forensics & Authenticity Analysis - .gitignore
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment & Secrets (Never commit credentials / local configs)
# --------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example

# --------------------------------------------------------------------
# 2. Large Model Weights & Checkpoints (Exceed GitHub 100MB limit)
# --------------------------------------------------------------------
*.pth
*.pt
*.bin
*.ckpt
*.h5
*.onnx
*.safetensors
*.pkl
*.joblib
*.weights

# Model archives & backups
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Retain directory structure in models/
!.gitkeep
!models/**/.gitkeep

# --------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# --------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
pip-log.txt
pip-delete-this-directory.txt

# --------------------------------------------------------------------
# 4. Python Bytecode, Caches & Test Artifacts
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --------------------------------------------------------------------
# 5. Frontend & Node.js Dependencies & Production Builds
# --------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.next/
.out/
.turbo/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------------
# 6. Generated Evidence, Temporary Uploads & Analysis Reports
# --------------------------------------------------------------------
*.pdf
temp/
tmp/
uploads/
scratch/
evidence_cache/
output/

# --------------------------------------------------------------------
# 7. Operating System & Editor Artifacts
# --------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Image files
*.png
*.jpg
*.jpeg
*.jpe
*.jfif
*.gif
*.bmp
*.dib
*.tif
*.tiff
*.webp
*.svg
*.ico
*.icns
*.heic
*.heif
*.avif
*.raw
*.cr2
*.cr3
*.nef
*.nrw
*.arw
*.dng
*.orf
*.rw2
*.pef
*.srw
*.psd
*.ai
*.eps
*.exr
*.hdr
*.jp2
*.j2k
*.jpf
*.jpx
*.jpm
*.mj2
*.apng
*.qoi
*.pbm
*.pgm
*.ppm
*.pnm
*.pcx
*.tga
*.dds
*.fits
*.fit
*.webm

# --- AI_detect: data (large, re-creatable by the scripts) ---
backend/AI_detect/data/train/real/
backend/AI_detect/data/train/fake/
backend/AI_detect/data/test_images/

# --- AI_detect: generated artifacts ---
backend/AI_detect/cache/
backend/AI_detect/results/*.png
